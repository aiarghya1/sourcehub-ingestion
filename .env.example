# ---------------------------------------------------------------------------
# Copy to .env if you want to override defaults. Everything is optional:
# with no DATABASE_URL the app uses an embedded PGlite database persisted to
# ./.data/pglite, so `npm install && npm run migrate && npm run dev` works
# out of the box with no external database.
# ---------------------------------------------------------------------------

# API server port (frontend dev server proxies /api here).
PORT=3001

# Postgres connection string. If set, the app uses it (e.g. Supabase/Render/
# local Postgres). If unset, it falls back to embedded PGlite (no server needed).
# DATABASE_URL=postgresql://postgres:PASSWORD@localhost:5432/sourcehub

# Where the embedded PGlite database is persisted when DATABASE_URL is unset.
PGLITE_DIR=./.data/pglite
